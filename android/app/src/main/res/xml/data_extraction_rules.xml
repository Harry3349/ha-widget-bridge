<?xml version="1.0" encoding="utf-8"?>
<!-- Zugriffstoken werden nicht gesichert: keine Cloud-Backups, kein Gerätetransfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
