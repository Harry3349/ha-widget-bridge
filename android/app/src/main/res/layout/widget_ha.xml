<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout des Homescreen-Widgets.

  RemoteViews kann keine Views zur Laufzeit inflaten, deshalb sind hier alle
  sechs möglichen Button-Zeilen fest deklariert und werden bei Bedarf
  eingeblendet (Standard: android:visibility="gone").
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    style="@style/WidgetRoot">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            style="@style/WidgetTitle"
            android:text="@string/widget_default_title" />

        <TextView
            android:id="@+id/widget_updated"
            style="@style/WidgetUpdated" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_content"
        style="@style/WidgetContent"
        android:text="@string/widget_placeholder" />

    <LinearLayout
        android:id="@+id/button_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/btn_row_1"
            style="@style/WidgetButtonRow">

            <ImageView
                android:id="@+id/btn_icon_1"
                style="@style/WidgetButtonIcon" />

            <TextView
                android:id="@+id/btn_label_1"
                style="@style/WidgetButtonLabel" />

            <TextView
                android:id="@+id/btn_state_1"
                style="@style/WidgetButtonState" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_row_2"
            style="@style/WidgetButtonRow">

            <ImageView
                android:id="@+id/btn_icon_2"
                style="@style/WidgetButtonIcon" />

            <TextView
                android:id="@+id/btn_label_2"
                style="@style/WidgetButtonLabel" />

            <TextView
                android:id="@+id/btn_state_2"
                style="@style/WidgetButtonState" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_row_3"
            style="@style/WidgetButtonRow">

            <ImageView
                android:id="@+id/btn_icon_3"
                style="@style/WidgetButtonIcon" />

            <TextView
                android:id="@+id/btn_label_3"
                style="@style/WidgetButtonLabel" />

            <TextView
                android:id="@+id/btn_state_3"
                style="@style/WidgetButtonState" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_row_4"
            style="@style/WidgetButtonRow">

            <ImageView
                android:id="@+id/btn_icon_4"
                style="@style/WidgetButtonIcon" />

            <TextView
                android:id="@+id/btn_label_4"
                style="@style/WidgetButtonLabel" />

            <TextView
                android:id="@+id/btn_state_4"
                style="@style/WidgetButtonState" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_row_5"
            style="@style/WidgetButtonRow">

            <ImageView
                android:id="@+id/btn_icon_5"
                style="@style/WidgetButtonIcon" />

            <TextView
                android:id="@+id/btn_label_5"
                style="@style/WidgetButtonLabel" />

            <TextView
                android:id="@+id/btn_state_5"
                style="@style/WidgetButtonState" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_row_6"
            style="@style/WidgetButtonRow">

            <ImageView
                android:id="@+id/btn_icon_6"
                style="@style/WidgetButtonIcon" />

            <TextView
                android:id="@+id/btn_label_6"
                style="@style/WidgetButtonLabel" />

            <TextView
                android:id="@+id/btn_state_6"
                style="@style/WidgetButtonState" />
        </LinearLayout>
    </LinearLayout>

    <!--
      Werte: sechs Zeilen mit je drei Feldern. Je nach Widget-Definition
      (value_columns 1..3) werden nur die passenden Felder eingeblendet –
      dadurch stehen die Werte nebeneinander. Innerhalb eines Felds steht
      der Name oben und der Wert darunter (value_label_above).
    -->
    <LinearLayout
        android:id="@+id/value_area"
        style="@style/WidgetValueArea">

        <LinearLayout
            android:id="@+id/value_row_1"
            style="@style/WidgetValueRow">

            <LinearLayout
                android:id="@+id/value_cell_1_1"
                style="@style/WidgetValueCell">

                <TextView
                    android:id="@+id/value_name_1_1"
                    style="@style/WidgetValueName" />

                <TextView
                    android:id="@+id/value_text_1_1"
                    style="@style/WidgetValueText" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/value_cell_1_2"
                style="@style/WidgetValueCellGap">

                <TextView
                    android:id="@+id/value_name_1_2"
                    style="@style/WidgetValueName" />

                <TextView
                    android:id="@+id/value_text_1_2"
                    style="@style/WidgetValueText" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/value_cell_1_3"
                style="@style/WidgetValueCellGap">

                <TextView
                    android:id="@+id/value_name_1_3"
                    style="@style/WidgetValueName" />

                <TextView
                    android:id="@+id/value_text_1_3"
                    style="@style/WidgetValueText" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/value_row_2"
            style="@style/WidgetValueRow">

            <LinearLayout
                android:id="@+id/value_cell_2_1"
                style="@style/WidgetValueCell">

                <TextView
                    android:id="@+id/value_name_2_1"
                    style="@style/WidgetValueName" />

                <TextView
                    android:id="@+id/value_text_2_1"
                    style="@style/WidgetValueText" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/value_cell_2_2"
                style="@style/WidgetValueCellGap">

                <TextView
                    android:id="@+id/value_name_2_2"
                    style="@style/WidgetValueName" />

                <TextView
                    android:id="@+id/value_text_2_2"
                    style="@style/WidgetValueText" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/value_cell_2_3"
                style="@style/WidgetValueCellGap">

                <TextView
                    android:id="@+id/value_name_2_3"
                    style="@style/WidgetValueName" />

                <TextView
                    android:id="@+id/value_text_2_3"
                    style="@style/WidgetValueText" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/value_row_3"
            style="@style/WidgetValueRow">

            <LinearLayout
                android:id="@+id/value_cell_3_1"
                style="@style/WidgetValueCell">

                <TextView
                    android:id="@+id/value_name_3_1"
                    style="@style/WidgetValueName" />

                <TextView
                    android:id="@+id/value_text_3_1"
                    style="@style/WidgetValueText" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/value_cell_3_2"
                style="@style/WidgetValueCellGap">

                <TextView
                    android:id="@+id/value_name_3_2"
                    style="@style/WidgetValueName" />

                <TextView
                    android:id="@+id/value_text_3_2"
                    style="@style/WidgetValueText" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/value_cell_3_3"
                style="@style/WidgetValueCellGap">

                <TextView
                    android:id="@+id/value_name_3_3"
                    style="@style/WidgetValueName" />

                <TextView
                    android:id="@+id/value_text_3_3"
                    style="@style/WidgetValueText" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/value_row_4"
            style="@style/WidgetValueRow">

            <LinearLayout
                android:id="@+id/value_cell_4_1"
                style="@style/WidgetValueCell">

                <TextView
                    android:id="@+id/value_name_4_1"
                    style="@style/WidgetValueName" />

                <TextView
                    android:id="@+id/value_text_4_1"
                    style="@style/WidgetValueText" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/value_cell_4_2"
                style="@style/WidgetValueCellGap">

                <TextView
                    android:id="@+id/value_name_4_2"
                    style="@style/WidgetValueName" />

                <TextView
                    android:id="@+id/value_text_4_2"
                    style="@style/WidgetValueText" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/value_cell_4_3"
                style="@style/WidgetValueCellGap">

                <TextView
                    android:id="@+id/value_name_4_3"
                    style="@style/WidgetValueName" />

                <TextView
                    android:id="@+id/value_text_4_3"
                    style="@style/WidgetValueText" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/value_row_5"
            style="@style/WidgetValueRow">

            <LinearLayout
                android:id="@+id/value_cell_5_1"
                style="@style/WidgetValueCell">

                <TextView
                    android:id="@+id/value_name_5_1"
                    style="@style/WidgetValueName" />

                <TextView
                    android:id="@+id/value_text_5_1"
                    style="@style/WidgetValueText" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/value_cell_5_2"
                style="@style/WidgetValueCellGap">

                <TextView
                    android:id="@+id/value_name_5_2"
                    style="@style/WidgetValueName" />

                <TextView
                    android:id="@+id/value_text_5_2"
                    style="@style/WidgetValueText" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/value_cell_5_3"
                style="@style/WidgetValueCellGap">

                <TextView
                    android:id="@+id/value_name_5_3"
                    style="@style/WidgetValueName" />

                <TextView
                    android:id="@+id/value_text_5_3"
                    style="@style/WidgetValueText" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/value_row_6"
            style="@style/WidgetValueRow">

            <LinearLayout
                android:id="@+id/value_cell_6_1"
                style="@style/WidgetValueCell">

                <TextView
                    android:id="@+id/value_name_6_1"
                    style="@style/WidgetValueName" />

                <TextView
                    android:id="@+id/value_text_6_1"
                    style="@style/WidgetValueText" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/value_cell_6_2"
                style="@style/WidgetValueCellGap">

                <TextView
                    android:id="@+id/value_name_6_2"
                    style="@style/WidgetValueName" />

                <TextView
                    android:id="@+id/value_text_6_2"
                    style="@style/WidgetValueText" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/value_cell_6_3"
                style="@style/WidgetValueCellGap">

                <TextView
                    android:id="@+id/value_name_6_3"
                    style="@style/WidgetValueName" />

                <TextView
                    android:id="@+id/value_text_6_3"
                    style="@style/WidgetValueText" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
