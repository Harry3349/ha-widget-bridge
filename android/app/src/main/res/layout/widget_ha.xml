<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout des Homescreen-Widgets.

  RemoteViews kann keine Views zur Laufzeit inflaten, deshalb sind hier alle
  sechs möglichen Button-Zeilen fest deklariert und werden bei Bedarf
  eingeblendet (Standard: android:visibility="gone").
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    style="@style/WidgetRoot">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            style="@style/WidgetTitle"
            android:text="@string/widget_default_title" />

        <TextView
            android:id="@+id/widget_updated"
            style="@style/WidgetUpdated" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_content"
        style="@style/WidgetContent"
        android:text="@string/widget_placeholder" />

    <LinearLayout
        android:id="@+id/button_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/btn_row_1"
            style="@style/WidgetButtonRow">

            <ImageView
                android:id="@+id/btn_icon_1"
                style="@style/WidgetButtonIcon" />

            <TextView
                android:id="@+id/btn_label_1"
                style="@style/WidgetButtonLabel" />

            <TextView
                android:id="@+id/btn_state_1"
                style="@style/WidgetButtonState" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_row_2"
            style="@style/WidgetButtonRow">

            <ImageView
                android:id="@+id/btn_icon_2"
                style="@style/WidgetButtonIcon" />

            <TextView
                android:id="@+id/btn_label_2"
                style="@style/WidgetButtonLabel" />

            <TextView
                android:id="@+id/btn_state_2"
                style="@style/WidgetButtonState" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_row_3"
            style="@style/WidgetButtonRow">

            <ImageView
                android:id="@+id/btn_icon_3"
                style="@style/WidgetButtonIcon" />

            <TextView
                android:id="@+id/btn_label_3"
                style="@style/WidgetButtonLabel" />

            <TextView
                android:id="@+id/btn_state_3"
                style="@style/WidgetButtonState" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_row_4"
            style="@style/WidgetButtonRow">

            <ImageView
                android:id="@+id/btn_icon_4"
                style="@style/WidgetButtonIcon" />

            <TextView
                android:id="@+id/btn_label_4"
                style="@style/WidgetButtonLabel" />

            <TextView
                android:id="@+id/btn_state_4"
                style="@style/WidgetButtonState" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_row_5"
            style="@style/WidgetButtonRow">

            <ImageView
                android:id="@+id/btn_icon_5"
                style="@style/WidgetButtonIcon" />

            <TextView
                android:id="@+id/btn_label_5"
                style="@style/WidgetButtonLabel" />

            <TextView
                android:id="@+id/btn_state_5"
                style="@style/WidgetButtonState" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_row_6"
            style="@style/WidgetButtonRow">

            <ImageView
                android:id="@+id/btn_icon_6"
                style="@style/WidgetButtonIcon" />

            <TextView
                android:id="@+id/btn_label_6"
                style="@style/WidgetButtonLabel" />

            <TextView
                android:id="@+id/btn_state_6"
                style="@style/WidgetButtonState" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
