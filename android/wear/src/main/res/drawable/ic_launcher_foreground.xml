<?xml version="1.0" encoding="utf-8"?>
<!--
    Vordergrund des App-Symbols auf der Uhr – gleiche Zeichnung wie die Handy-App
    (grünes Power-Zeichen auf dunklem Grund). Ohne eigenes adaptives Symbol setzt
    Wear OS das weiße `ic_power` in einen weißen Kreis – dort war nichts zu sehen.
    Die Zeichenfläche ist 108x108 dp: die äußeren 18 dp schneidet die runde Maske ab.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M54,32 L54,54"
        android:strokeColor="#FF00E676"
        android:strokeLineCap="round"
        android:strokeWidth="7" />
    <path
        android:pathData="M38,41 A22,22 0 1 0 70,41"
        android:strokeColor="#FF00E676"
        android:strokeLineCap="round"
        android:strokeWidth="7" />
</vector>
